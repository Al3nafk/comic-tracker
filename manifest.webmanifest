{
  "name": "Comic Tracker",
  "short_name": "Comics",
  "description": "Track manga, manhwa, manhua and webtoons, read chapters and get told about new ones.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
